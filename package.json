{
  "name": "milk-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply milk-delivery-db --local",
    "db:seed": "wrangler d1 execute milk-delivery-db --local --file=./src/server/db/seed.sql",
    "deploy": "node scripts/validate-deploy.mjs production && wrangler deploy --env production",
    "deploy:dry-run": "node scripts/validate-deploy.mjs staging && wrangler deploy --dry-run --env staging"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "^0.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "miniflare": "^5.20261006.1-alpha",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
